# URL publique du site (utilisée pour le sitemap, robots.txt, metadata SEO)
NEXT_PUBLIC_SITE_URL=https://www.zahdigit.com

# Supabase — stockage des leads du formulaire de contact (Sprint 4)
# Clé service_role : jamais exposée côté client, utilisée uniquement dans app/api/contact/route.ts
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend — envoi des emails de confirmation prospect + notification agence
RESEND_API_KEY=
# Adresse expéditrice, doit appartenir à un domaine vérifié sur Resend
CONTACT_FROM_EMAIL=
# Boîte interne recevant la notification de chaque nouveau lead
CONTACT_NOTIFICATION_EMAIL=
