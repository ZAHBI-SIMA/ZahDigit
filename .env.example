# URL publique du site (utilisée pour le sitemap, robots.txt, metadata SEO)
NEXT_PUBLIC_SITE_URL=https://www.zahdigit.com

# Supabase — client API (lecture/écriture des leads), Project Settings → API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase — connexion Postgres directe, utilisée UNIQUEMENT pour créer
# automatiquement la table leads au démarrage (l'API REST ci-dessus ne
# permet pas d'exécuter du CREATE TABLE). Project Settings → Database →
# Connection string (mode "Session" ou "Transaction pooler" recommandé).
DATABASE_URL=

# Resend — envoi des emails de confirmation prospect + notification agence
RESEND_API_KEY=
# Adresse expéditrice, doit appartenir à un domaine vérifié sur Resend
CONTACT_FROM_EMAIL=contact@zahdigit.com
# Boîte interne recevant la notification de chaque nouveau lead
CONTACT_NOTIFICATION_EMAIL=info@zahdigit.com
